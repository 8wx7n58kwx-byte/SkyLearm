# Required before the first production deployment
# Never commit the real .env file. Use a unique password of at least 12 characters.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password

# Comma-separated HTTPS origins allowed to call the API.
# Example: https://your-frontend.example.com
ALLOWED_ORIGINS=https://your-frontend.example.com

# Optional. A long random value used to sign sessions.
# If omitted, the app currently creates a local .session_secret at runtime.
SECRET_KEY=replace-with-a-long-random-secret
